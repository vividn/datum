#!/usr/bin/awk -f


BEGIN {
    OFS="\t"
}

BEGINFILE {
    # Use a datum subdirectory with the same name as the processed datum file
    basefile=FILENAME;
    gsub(".*/|\\.tsv","",basefile);

    # Failsafe to avoid deleting normal datum files
    if (basefile == "") {
        exit 1
    }

    subdir="/home/vividn/Data/datum/"basefile
    # Make the subdirectory if it doesn't exist
    system("mkdir -p "subdir);

    # Remove the files within (they will be regenerated by this script)
    system("rm "subdir"/*")

    # Make the current subblock blank for this file
    currentblock=""
}

# Skip any rows that don't look like data. For example, the header row
$1 !~ /^[-0-9]+/ {
    next
}

# If the 3rd argument is end, rather than a name, just end the currentblock without starting a new one.
$3 == "end" {
    if (currentblock != "") {
        NF = 3
        print >> subdir"/"currentblock

        currentblock=""
    }
    next
}

# If a number of minutes is specified in $4, just create a temporary block and the corresponding anti-block
$4 ~ /[0-9]+(.[0-9]+)?/ {
    # Get the filename from the third column
    tempblock=$3

    # Now change the record to have the minutes in the third column
    $3 = $4
    NF = 3

    # Write the temp block
    print >> subdir"/"tempblock".tsv"

    # Write the corresponding antiblock (if a current block is open)
    if (currentblock != "") {
        $3 = $3 * -1
        print >> subdir"/"currentblock".tsv"
    }

    # Note: currentblock is not changed since this is just a temporary block
    next

}

{
    # The third column is the new block name
    newblock=$3

    # Now start a new block in this file name
    $3 = "start"
    NF = 3
    print >> subdir"/"newblock".tsv"

    # Write and end in the old block
    $3 = "end"
    print >> subdir"/"currentblock".tsv"

    # A new block is started
    currentblock = newblock
}

ENDFILE {
    header_string = "Date\tTime\tMinutes"

    # Use sed to put a header line in all the new data files
    system("sed -i '1i"header_string"' "subdir"/*")
}
