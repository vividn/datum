#!/bin/bash

# This program is to collect time stamped data quickly and efficiently

# First, collect a timestamp as soon as possible:
TIMESTR=$(date "+%H:%M:%S.%3N")
DATESTR=$(date "+%Y-%m-%d")

DATADIR=~/Data/datum

AFLAGDATA=''
FORCE=

mode=normal

# Get options
while getopts "f:d:t:TDa:uUis-" opt; do
  case $opt in
    f)  # Specify the file to put the data in, if this flag is not set, the first argument will be the file
        FILE="$DATADIR/$OPTARG.tsv"
        BASENAME="$OPTARG"
    ;;
    
    d)  # Specify date
        DATEFLAG=true
      
        if [ "${OPTARG:0:1}" = "-" ]; then
			# Allow relative dates by starting with a minus sign (-1 = yesterday, etc.)
            DATESTR=$(date --date "${OPTARG:1} days ago" '+%Y-%m-%d')
        
		else
			# Otherwise, feed the date into the linux date utility 
            DATESTR=$(date --date $OPTARG "+%Y-%m-%d")
        
		fi
    ;;
    
    t) # Specify time
        TIMEFLAG=true
        if [ "${OPTARG:0:1}" = "-" ]; then
            # If a negative number is given, subtract that many minutes (round to nearest minute for analysis reasons later)
            TIMESTR=$(date --date "${OPTARG:1} minutes ago" '+%H:%M')
            TIMESTR=$(date --date $TIMESTR "+%H:%M:%S.%3N")
        else
            TIMESTR=$(date --date $OPTARG "+%H:%M:%S.%3N")
        fi

    ;;
    
    T) # Shortcut for -t 23:59:59.999
        TIMEFLAG=true
        TIMESTR="23:59:59.999"
    ;;

    D) # Shortcut for -d -1
        DATEFLAG=true
        DATESTR=$(date --date yesterday '+%Y-%m-%d')
    ;;

    a) # Flag to include tab separated data earlier in the list. Useful for aliases
        AFLAGDATA="$AFLAGDATA\t$OPTARG"
    ;;
    u) # Undo the last data point made
        UNDOLAST=true
    ;;

    U) # Force undo (no time limit)
        UNDOLAST=true
        FORCE=true
    ;;

    i) # Interactive mode. Records timings of keystrokes for on the fly data collection
		mode=interactive
    ;;

    s) # state mode, load in the last datum entry into a text editor for manual editing in order to create the next entry. Useful for slowly changing multistate systems, e.g., list of health conditions
        mode=state
        ;;


    -) # -- no more arguments
        break;
        ;;

        
    esac
done

shift "$((OPTIND - 1))"

function makeTimestamp {
    TIMESTAMP=$DATESTR"\t"$TIMESTR 
}
makeTimestamp

# The first argument speifies the file (if not specified via -f)
if [ -z "$FILE" ]; then
    FILE="$DATADIR/$1.tsv"
    BASENAME="$1"
    shift
fi

#Separate everything by tabs
IFS='	'

if [ ! -z "$UNDOLAST" ]; then
    # Undo the last data point made

	  # To avoid accidental data loss, undo is allowed only if last entry was made less than 15 minutes ago 
	  if [ ! -z "$FORCE" ] || [ $(find $FILE -mmin -15) ]; then
	      DELETEDLINE=$(tail -n 1 $FILE)
        TMPFILE=$(mktemp)

		    # Delete the last line
		    head -n -1 $FILE > $TMPFILE
		    mv $TMPFILE $FILE
		    echo "DELETED $(tput smul; tput setaf 3)$BASENAME$(tput sgr0): $DELETEDLINE"
		    
        # Record the deleted line in undo datum file
        echo -e "$BASENAME\t$DELETEDLINE" >> $DATADIR/undo.tsv

		    # Change modified time to stop more deletions happening
		    touch -m -t $(date -d 'now - 15 minutes' +%Y%m%d%H%M) $FILE
		    exit 0
		    
	  else
		    echo "Nothing deleted. File older than 15 minutes."
		    exit 1
	  fi
fi

case $mode in

    normal)
        # In normal mode a single entry is recorded into the data file
        # with the time stamp and whatever other arguments are specified on the
        # command line separated by tabs

        # If no additional arguments are given don't add the trailing tab
        if [ -z "$*" ]; then
            OUTPUTSTRING="$TIMESTAMP""$AFLAGDATA"
        else
            OUTPUTSTRING="$TIMESTAMP""$AFLAGDATA""\t$*"
        fi

        echo -e "$(tput smul; tput setaf 3)$BASENAME$(tput sgr0): $OUTPUTSTRING"
	      echo -e "$OUTPUTSTRING" >> $FILE
        ;;

    state)
        # In state mode, the last entry's columns (except for Date and Time) are loaded as individual lines in vim
        # The user can edit this and then a new entry is create from the lines.
        # This is useful for slow-changing multistate data, such as health conditions.

        # Create a temporary file to do all these edits in
        tmpfile=$(mktemp)

        # Get the last entry
        # Remove header line at top of file to avoid sorting problems
        if [ $(wc -l < $FILE) -gt 1 ]; then
            tail -n +2 $FILE | sort | tail -n1 | cut -f 3- | tr "\t" "\n" > $tmpfile
        else
            tail -n1 $FILE | cut -f 3- | tr "\t" "\n" > $tmpfile
        fi

        # Open up the file for editing
        sensible-editor $tmpfile

        # Reget timestamp unless it was specified
        if [ -z $TIMEFLAG ]; then
            TIMESTR=$(date "+%H:%M:%S.%3N")
        fi
        if [ -z $DATEFLAG ]; then
            DATESTR=$(date "+%Y-%m-%d")
        fi
        makeTimestamp

        # Process the  tmpfile into a datum formatted line
        tabdata="$(tr '\n' '\t' <$tmpfile | sed -E 's|\t$||')"
        OUTPUTSTRING="$TIMESTAMP\t$tabdata"

        # Write to file
        echo -e "$(tput smul; tput setaf 3)$BASENAME$(tput sgr0): $OUTPUTSTRING"
	      echo -e "$OUTPUTSTRING" >> $FILE

        # Remove tmpfile
        rm $tmpfile
        ;;


    interactive)
        # In interactive mode, key presses cause data entries until Ctrl-C is received
        # Arguments can be passed on the command line. Format should be a single letter
        # followed by whatever that letter should be recorded as. For example:
        # datum -f car-colors -i r red b blue k black

        # Clear the screen and hide the cursor
        tput clear
        tput civis

        # Declare an associative array to reference the keystrokes to later
        declare -A letters

        # Load the arguments in
        while [ "$#" -gt 0 ]; do
            # Make sure each pair starts with a single character
            case "$1" in
                ?)
                # Then store the paired argument into the associative array
                letters["$1"]="$2"

                # Show the matching at the top of the screen
                echo -n "$1=$2  "

                shift 2
                ;;

                *)
                    # Otherwise, shift that argument away and record that some argument was skipped
                    echo -n "{ERR}  "
                    shift 1
                    ;;
            esac
        done



        # Write the output file at the top
        echo -e "\n$(tput smul)Interactive: $FILE$(tput rmul)"

        # Record the start time
        TIMESTR=$(date "+%H:%M:%S.%3N")
        DATESTR=$(date "+%Y-%m-%d")
        echo -e "$DATESTR\t$TIMESTR\t[start]$AFLAGDATA" | tee -a $FILE

        # Set up a trap so that when the function exits, the finish time is recorded
        function finish {
            TIMESTR=$(date "+%H:%M:%S.%3N")
            DATESTR=$(date "+%Y-%m-%d")
            echo -e "$DATESTR\t$TIMESTR\t[end]" | tee -a $FILE
            tput cnorm
        }
        trap finish EXIT

        # Now, loop reading one character at a time until the program is stopped with Ctrl-C
        while true; do
            read -s -n 1 key

            # Immediately get the timestamp
		        TIMESTR=$(date "+%H:%M:%S.%3N")
		        DATESTR=$(date "+%Y-%m-%d")

		        # Reference the key against the associative array generated earlier
		        DATAVAL="${letters[$key]}"

		        if [ -z "$DATAVAL" ]; then
			          # Just record the letter if no match is found
			          DATAVAL=$key
		        fi

		        echo -e "$DATESTR\t$TIMESTR\t$DATAVAL" | tee -a $FILE
	      done
        ;;
esac

