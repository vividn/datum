#!/usr/bin/env python3

import requests
import sys
import getopt

args = sys.argv[1:]

opts, positional_args = getopt.gnu_getopt(args, 'a:d:')

positional_keys = []
database_name = None
payload = {}

for opt in opts:
    if opt[0] == '-a':
        positional_keys += [opt[1]]

    elif opt[0] == '-d':
        if database_name is None:
            database_name = opt[1]
        else:
            raise ValueError('database cannot be specified more than once')

if database_name is None:
    raise ValueError('database must be specified')

for arg in positional_args:
    eq_split = arg.split('=')
    if len(eq_split) == 1:
        key = positional_keys.pop(0)
        value = eq_split[0]
    else:
        key = eq_split[0]
        value = ''.join(eq_split[1:])

    if key in payload.keys():
        current = payload[key]
        if isinstance(current, list):
            value = current + [value]
        else:
            value = [current, value]

    payload[key] = value

print(payload)

username = 'admin'
password = "***REMOVED***"

response = requests.post(f"http://localhost:5984/{database_name}", auth=(username, password), json=payload)
print(response.content)