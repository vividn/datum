function resleep {
    if in-block sleep; then
        datum -f sleep -U
        asleep
    else
        echo "You are not asleep" >&2
        return 1
    fi
}


function alarm {
    # For easy undos
    if [ "$1" = "-u" ]; then
        datum -f alarm -u
        return
    fi

    if [[ "$1" =~ "\+[0-9]+" ]]; then
        args="now $1 minutes"
    else
        args="$*"
    fi

    # In order to determine if the time is in the future use the current time as a basis
    now=$(date +%s)
    alarmseconds=$(date -d "$args" +%s)
    alarmtime=$(date -d "$args" +%H:%M:%S)
    if [ $alarmseconds -gt $now ]; then
        alarmdate=$(date -d "$args" +%Y-%m-%d)
    else
        alarmdate=$(date -d "$args + 1 day" +%Y-%m-%d)
    fi

    datum -f alarm -d $alarmdate -t $alarmtime
}

