
# Function that lets me scale the input value
function dmult {
    datum_file="$1"
    mult="$2"
    shift; shift

    # Undo if a -u is given
    if [ "$1" = "-u" ]; then
        datum -f "$datum_file" -u
        return 0
    elif [ "$1" = "-U" ]; then
        datum -f "$datum_file" - U
        return 0
    fi

    # Multiply the last argument by the multiplier
    last_arg="${@: -1}"
    let 'last_arg *= mult'
    # Remove trailing decimal point if an integer
    last_arg=$(echo "$last_arg" | bc)

    datum -f "$datum_file" ${@:1:-1} "$last_arg"
}

