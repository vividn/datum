function dget () {
    # Extrapolates from the first few characters if possible
    # Also adds the file extension if needed
    dname=$1

    dfile=(~/Data/datum/$dname*)

    # If that matches more than one file name, exit with error
    if [ $#dfile -gt 1 ]; then
        return 2
    fi

    echo $dfile
}

function dtail () {
    name="$1"
    dfile=$(dget $1)
    if [ $? -gt 0 ]; then
        return $?
    fi
    shift

    # If a -d flag is next, use dgrep to grab the entries for a particular day
    if [[ "$1" == "-d" ]]; then
        shift
        date=$(date -d "$*" '+%Y-%m-%d')
        dgrep $name $date
    else
        # Use tail to print the last few entries
        # Print header line first
        (head $dfile -n1; (sort $dfile | head -n-1 | tail $* )) | column -t -s $'\t' -n
    fi

}

function dhead () {
    dfile=$(dget $1)
    if [ $? -gt 0 ]; then
        return $?
    fi
    shift

    # Print header line first
    (head $dfile -n1; (head $dfile $* | sed '1d' | sort)) | column -t -s $'\t' -n
}

function dgrep () {
    dfile=$(dget $1)
    if [ $? -gt 0 ]; then
        return $?
    fi
    shift

    # Print header line first
    (head $dfile -n1; (grep -i $* $dfile | sort)) | column -t -s $'\t' -n

}

function dless () {
    dfile=$(dget $1)
    if [ $? -gt 0 ]; then
        return $?
    fi
    shift

    # Print header line and feed into nice columns
    (head $dfile -n1; (cat $dfile $* | sed '1d' | sort)) | column -t -s $'\t' -n | less
}


