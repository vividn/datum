function project {
    if [ $# -eq 0 ]; then
        iba
    fi

    # First argument is optional and can set the activity type
    case $1 in
        hw)
            act=hw
            shift
            ;;
        work|w)
            act=work
            shift
            ;;
        volunteer|vol|v)
            act=volunteer
            shift
            ;;
        *)
            # If no activity is specified, use currently active activity
            act=$(iba 1)
            if [ -z $act ]; then
                # hw is default activity
                act=hw
            fi
    esac

    if [ $# -eq 0 ]; then
        datum -f activity -a $act -a end
    else
        datum -f activity -a $act $*
    fi

}

