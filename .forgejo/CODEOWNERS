# Forgejo requests @vividn's review on any PR changing these paths. Each pattern is a
# regular expression anchored ^...$, not a glob; the tokenizer eats one backslash,
# so a literal dot is \\.
\\.forgejo/.* @vividn
\\.github/.* @vividn
release/.* @vividn

# What the dependency hold rests on (da-jks33): the release-age delay and the check.
web/pnpm-workspace\\.yaml @vividn
scripts/lockfile-check\\.py @vividn
