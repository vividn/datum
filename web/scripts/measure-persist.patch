+pub fn lines() -> Result<()> {
+    use std::io::{BufRead, Write};
+    let _ = datum_core::BUILD.set(env!("DATUM_BUILD"));
+    datum_core::db::set_client_source(|| config::client_id().ok());
+    datum_core::db::set_device_source(|| config::device_key().ok());
+    let resolved = config::resolve_db(None)?;
+    let path = resolved.path.to_string_lossy().into_owned();
+    let db = datum_core::db::Db::open(&path)?;
+    datum_core::phases::mark("lines.opened");
+    eprintln!("DATUM_OPEN {}", datum_core::phases::take());
+    let input = std::io::stdin().lock().lines().collect::<Vec<_>>();
+    for line in input {
+        let line = line?;
+        if line.trim().is_empty() {
+            continue;
+        }
+        let words: Vec<String> = line.split('\t').map(String::from).collect();
+        // Leading `=KEY=VAL` words are this line's env, set for it alone.
+        let env: Vec<(String, String)> = words
+            .iter()
+            .map_while(|w| w.strip_prefix('=')?.split_once('='))
+            .map(|(k, v)| (k.to_string(), v.to_string()))
+            .collect();
+        let argv = words[env.len()..].to_vec();
+        datum_core::phases::mark("line.start");
+        for (k, v) in &env {
+            // SAFETY: one thread.
+            unsafe { std::env::set_var(k, v) };
+        }
+        args::reset_duplicate_noop();
+        let mut full = vec!["datum".to_string()];
+        full.extend(argv);
+        let code = match args::parse_invocation_with_db(full, &db) {
+            Ok(inv) => {
+                datum_core::phases::mark("parsed");
+                match run_on(&db, &path, inv) {
+                    Ok(()) => 0,
+                    Err(e) => {
+                        eprintln!("Error: {e:?}");
+                        1
+                    }
+                }
+            }
+            Err(e) => {
+                eprintln!("Error: {e:?}");
+                2
+            }
+        };
+        datum_core::phases::mark("ran");
+        for (k, _) in &env {
+            // SAFETY: one thread.
+            unsafe { std::env::remove_var(k) };
+        }
+        let _ = std::io::stdout().flush();
+        println!("\u{1e}");
+        let _ = std::io::stdout().flush();
+        eprintln!("DATUM_LINE {code} {}", datum_core::phases::take());
+    }
