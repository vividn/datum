+/// MEASUREMENT ONLY (da-zv6hn): where a process's time goes.
+pub mod phases {
+    use std::sync::Mutex;
+    use std::time::Instant;
+    static MARKS: Mutex<Vec<(&'static str, Instant)>> = Mutex::new(Vec::new());
+    pub fn mark(name: &'static str) {
+        if let Ok(mut v) = MARKS.lock() {
+            v.push((name, Instant::now()));
+        }
+    }
+    /// The marks since the first, as `name=ms` deltas from the one before, and cleared.
+    pub fn take() -> String {
+        let mut v = MARKS.lock().unwrap();
+        let out = v
+            .windows(2)
+            .map(|w| format!("{}={:.2}", w[1].0, (w[1].1 - w[0].1).as_secs_f64() * 1e3))
+            .collect::<Vec<_>>()
+            .join(" ");
+        v.clear();
+        // The linear memory as it stands, which never shrinks: a process's peak.
+        #[cfg(target_arch = "wasm32")]
+        let out = format!("{out} mem={}", core::arch::wasm32::memory_size(0) * 64 * 1024);
+        out
+    }
+}
