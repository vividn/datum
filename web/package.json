{
  "name": "datum-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:schema": "node scripts/generate-schema.mjs",
    "predev": "node scripts/generate-schema.mjs",
    "prebuild": "node scripts/generate-schema.mjs",
    "precheck": "node scripts/generate-schema.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:fixtures": "node scripts/capture-cli-fixtures.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "playwright": "^1.62.1",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.3"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.51.2-build9",
    "ulid": "^2.3.0"
  },
  "type": "module"
}
