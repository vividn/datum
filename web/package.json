    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-language-server": "^0.18.5",
    "tslib": "^2.4.1",
    "typescript": "^6.0.0",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
