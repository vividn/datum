    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.3"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2"
