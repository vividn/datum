#!/bin/bash

# When datum files diverge on different computers, it is important to resync them, but lose no data.
# Datum files are append-only, so merge-datum use comm to pair up lines until a diference is found and then cats the unison and the two differences into a single output stream.

# Output all the similar lines between the two files
comm --nocheck-order -21 "$1" "$2"

# Now output the lines just in $1
comm --nocheck-order -32 "$1" "$2"
# And just in $2
comm --nocheck-order -31 "$1" "$2"
